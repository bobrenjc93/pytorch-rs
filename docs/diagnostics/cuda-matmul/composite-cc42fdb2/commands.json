      "-c",
      "\nimport json,sys\nfrom pathlib import Path\nsys.path.insert(0,str(Path('scripts').resolve()))\nfrom evaluate_cuda_math import source_provenance,sha256,runtime_provenance\nimport torch\nimport torch_rs as native\nimport torch_rs.torch_rs as extension\nimport numpy as np\ntorch.backends.cuda.matmul.allow_tf32=False\nresults=[]\nfor k in (4096,8192,16384,32768,65536,65539,131072,262144,1000000):\n for value,weight in ((.1,1.),(-.1,1.),(.1,.1),(-.1,.1)):\n  observed=[]\n  for module in (native,torch):\n   a=module.full((1,k),value,dtype=module.float32).to('cuda:0')\n   b=module.full((k,1),weight,dtype=module.float32).to('cuda:0')\n   observed.append((a@b).cpu().item())\n  np.testing.assert_allclose(*observed,rtol=1e-5,atol=1e-4)\n  results.append(dict(k=k,left=value,right=weight,native=observed[0],pytorch=observed[1]))\nfor k in (1031,2048):\n for repeat in range(2):\n  observed=[]\n  for module in (native,torch):\n   a=module.tensor([2.**127,2.**127,-2.**127,-2.**127]+[0.]*(k-4),dtype=module.float32).reshape(1,k).to('cuda:0')\n   b=module.ones((k,1),dtype=module.float32).to('cuda:0')\n   observed.append((a@b).cpu().item())\n  assert observed==[0.,0.],observed\n  results.append(dict(k=k,repeat=repeat,probe='intermediate overflow cancellation',native=observed[0],pytorch=observed[1]))\nprint(json.dumps(dict(measurement_kind='clean-code',source=source_provenance(),extension=extension.__file__,extension_sha256=sha256(extension.__file__),runtime=runtime_provenance(),tf32=False,rtol=1e-5,atol=1e-4,results=results),indent=2))\n"
